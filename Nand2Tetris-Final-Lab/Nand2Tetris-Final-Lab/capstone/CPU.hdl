CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Decode instruction type: A-instruction has instruction[15] == 0;
    // C-instruction has instruction[15] == 1.
    Not(in=instruction[15], out=isA);

    // Select ARegister input: instruction if A-instruction, else ALU output.
    Mux16(a=aluOut, b=instruction, sel=isA, out=aIn);

    // Load ARegister on A-instruction or C-instruction with d1 (instruction[5]) set.
    Or(a=isA, b=instruction[5], out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // Select ALU y-input: ARegister output if a-bit (instruction[12]) == 0, else inM.
    Mux16(a=aOut, b=inM, sel=instruction[12], out=amOut);

    // Load DRegister on C-instruction with d2 (instruction[4]) set.
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    // Execute ALU operation using control bits c1..c6 (instruction[11..6]).
    ALU(
        x=dOut,
        y=amOut,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zr,
        ng=ng
    );

    // Write to memory on C-instruction with d3 (instruction[3]) set.
    And(a=instruction[15], b=instruction[3], out=writeM);

    // Evaluate jump conditions (j1=instruction[2], j2=instruction[1], j3=instruction[0]).
    // Positive if neither zero (zr) nor negative (ng).
    Or(a=zr, b=ng, out=notPos);
    Not(in=notPos, out=pos);

    And(a=instruction[2], b=ng, out=jlt);   // < 0
    And(a=instruction[1], b=zr, out=jeq);   // == 0
    And(a=instruction[0], b=pos, out=jgt);  // > 0

    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=jumpCond);

    // Jump only on C-instructions.
    And(a=instruction[15], b=jumpCond, out=loadPC);
    Not(in=loadPC, out=incPC);

    // Program counter: reset overrides load and inc.
    PC(in=aOut, load=loadPC, inc=incPC, reset=reset, out[0..14]=pc);
}
